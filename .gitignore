# ----------------------------
# System / OS
# ----------------------------
# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor swap / temp
*~
*.swp
*.swo
*.tmp

# ----------------------------
# LOGS / DUMP
# ----------------------------
*.log
logs/
*.log.*
hs_err_pid*
java_pid*.log
*.stacktrace

# ----------------------------
# JAVA / MAVEN / SPRING BOOT
# ----------------------------
# Compiled class files
*.class

# Build outputs
/target/
/build/
!**/src/main/**/target/
!**/src/test/**/target/

# JAR/WAR/EAR
*.jar
*.war
*.ear

# Maven wrapper (keep properties, ignore jar if desired)
/.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.properties

# Maven local repository (if ever placed inside project)
.m2/

# IntelliJ / JetBrains (IDE)
.idea/
*.iml
*.iws
*.ipr
/out/

# Eclipse / STS
.classpath
.project
.settings/
.factorypath
.springBeans
.apt_generated
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Gradle (Android / multi-tool builds)
.gradle/
gradle-app.setting
gradle-wrapper.jar
gradle-wrapper.properties
.gradle-cache/

# ----------------------------
# DATABASE / DOCKER (PostgreSQL)
# ----------------------------
# PostgreSQL data directories often named pgdata, postgres-data, data/postgres, etc.
pgdata/
postgres-data/
data/postgres/
psql_data/
*.sql.gz

# If using Docker volumes, ignore common compose override and env local files
docker-compose.override.yml
docker-compose.*.yml
docker-compose.*.local.yml

# ----------------------------
# SECURITY / KEYS
# ----------------------------
# Keystores, private keys, credentials
*.jks
*.keystore
*.p12
*.pem
*.key
*.crt

# JWT / secret files
secrets/
secret-*.json

# ----------------------------
# NODE / FRONTEND (TypeScript, Vite)
# ----------------------------
# dependency directories
node_modules/
**/node_modules/

# build outputs
/dist
/build
/out
/public/build

# Vite cache
.vite
.vite/cache

# TypeScript build info
*.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Lockfile (usually tracked, so not ignored) - do NOT ignore package-lock.json/yarn.lock unless desired.

# Environment files (include .env as requested)
.env
.env.*
**/.env

# Vite / local dev
.vscode/
.vscode/*

# Cocoapods artifacts
**/Pods/

# Expo
.expo/
.expo-shared/

# Metro bundler cache / temp
.expo/
metro-cache/
tmp/
temp/

# Keystore and signing files (React Native)
*.keystore
*.jks

# ----------------------------
# TESTS / COVERAGE
# ----------------------------
coverage/
.nyc_output/
jest-cache/
jest-report/
test-results/
reports/

# ----------------------------
# CI / Tools
# ----------------------------
# GitHub Actions, CircleCI etc - keep your config but ignore runner caches
/.github/actions/_cache/
/.circleci/cache/

# ----------------------------
# MISC
# ----------------------------
# OS-specific editor folders
.vscode/
.vscode/*

# IDE-specific
.idea/

# Temporary files
*.bak
*.orig

# npm / pnpm / yarn global caches if accidentally placed here
.pnpm-store/
.yarn/cache/
